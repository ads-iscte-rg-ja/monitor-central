# PostgreSQL Configuration
# Host-local Go commands connect here. Compose overrides its containers to
# POSTGRES_HOST=postgres and POSTGRES_PORT=5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=pay_demo_db
POSTGRES_SSLMODE=disable

# Optional database pool settings
# With several instances (ADR-0007), instances x POSTGRES_MAX_OPEN_CONNS must stay
# below PostgreSQL's max_connections (100 by default): 3 x 20 = 60.
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=5
# Ingestion requests served at once (ADR-0006). Each uses at most one database
# connection, so the rest of the pool stays free for the dashboard and jobs.
# Default: 60% of POSTGRES_MAX_OPEN_CONNS; must be lower than it. With N instances
# (ADR-0007) the limit applies to each one: set the total ingestion budget / N.
# INGEST_MAX_INFLIGHT=12
# Browser requests served at once, and the deadline of each one's database work
# (ADR-0017): a slow page cannot take the pool from the ingestion and the jobs.
# Default: 20% of POSTGRES_MAX_OPEN_CONNS; with INGEST_MAX_INFLIGHT it must leave
# a connection free. The timeout goes from 1s to 25s. A request that waits more
# than 2 s for a slot gets 503 with Retry-After.
# DASHBOARD_MAX_INFLIGHT=4
# DASHBOARD_QUERY_TIMEOUT=10s
# Deadline of cmd/migrate (1m to 24h). Some migrations read whole tables
# (ADR-0017): raise it before upgrading a database with weeks of telemetry.
# MIGRATE_TIMEOUT=30m

# Server Configuration
# PORT controls the host-side Docker publication (loopback-only). The Docker
# backend always listens on 3333 and uses FRONTEND_PATH=/app/frontend internally.
PORT=3333
# gRPC telemetry ingestion (monitor-remote connects here). Same loopback-only
# publication; the container always listens on 3334.
GRPC_PORT=3334
# Metrics (Prometheus format) on a separate, non-public listener; empty disables.
# Docker always listens on :9464 inside each container and publishes it on an
# ephemeral loopback port (docker compose port backend 9464).
METRICS_ADDR=127.0.0.1:9464
# Several instances (ADR-0007). APP_ROLE: all (default), web (HTTP and gRPC, no
# background jobs) or worker (background jobs and /health only). Whatever the
# roles, each background job runs on one instance at a time.
# APP_ROLE=all
# Comma-separated addresses or CIDR ranges of the load balancers allowed to
# report the client address in X-Forwarded-For (used by the login limiter).
# Empty: the header is never read. Docker Compose sets the nginx address.
# TRUSTED_PROXIES=

# Health probes in flight at once (ADR-0013), 1-1024. 128 fits 1,000 hosts with
# half of them timing out; raise it only for more hosts.
# HEALTH_CONCURRENCY=128

# Time zone of alert times, error times and the 09:00 daily summary (ADR-0014).
# An unknown zone stops the start-up.
# APP_TIMEZONE=Europe/Lisbon

# Content-Security-Policy (ADR-0016): enforce (default) or report-only, which only
# reports violations to /csp-report (logged as warnings) while a page is changed.
# HSTS and the __Host- session cookie follow COOKIE_SECURE.
# CSP_MODE=enforce

# Structured logs: json (default) or text; debug, info, warn or error.
LOG_FORMAT=json
LOG_LEVEL=info
APP_ENV=development
FRONTEND_PATH=frontend

# Required HMAC-SHA256 secret. Generate privately with: go run ./cmd/key-secret
# Exactly 32 random bytes encoded as 64 hex characters. Preserve with DB backups.
HOST_API_KEY_SECRET=

# Login limits: attempts per fixed one-minute window, per process
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPTS_PER_ACCOUNT=5
LOGIN_MAX_CONCURRENT=4

# Data retention in days; 0 disables cleanup for that category. On by default
# (ADR-0017), with the values below.
# RETENTION_STATS_DAYS=30
# RETENTION_ERRORS_DAYS=30
# RETENTION_RESOLVED_EVENTS_DAYS=180
# RETENTION_SENT_EMAIL_DAYS=30
# RETENTION_AUDIT_DAYS=365
# At most CLEANUP_BATCH_SIZE rows per category per run. The defaults keep up with
# 1,000 hosts (measured: 2.6x the incoming rate); lower them only with fewer hosts.
# CLEANUP_INTERVAL=1m
# CLEANUP_BATCH_SIZE=10000

# Operator-managed administrator (required by cmd/seed; no signup)
ADMIN_EMAIL=admin@example.com
# Set a private password containing 12–72 bytes; no default is provided
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional initial alert recipient; later editable on /profile
ADMIN_NOTIFICATION_EMAIL=

# SMTP Configuration (Mailtrap or similar)
# In Docker, localhost is the backend container, not the host machine.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@monitor.example

# Cookie Configuration
# Set to true in production with HTTPS
COOKIE_SECURE=false
